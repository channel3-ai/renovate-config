{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/New_York)",
    "docker:pinDigests",
    "group:monorepos",
    "group:recommended",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "5 days",
  "constraints": {
    "pnpm": "10.6.2"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "assignees": ["glaw1300"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group all non-major Python updates into one PR per week",
      "matchManagers": ["pep621", "pip_requirements", "poetry", "pip-compile", "setup-cfg"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python non-major"
    },
    {
      "description": "Group all non-major JS updates into one PR per week",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "js non-major"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Docker image digest refreshes on the weekly schedule",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "docker image digest updates",
      "labels": ["dependencies", "docker"]
    },
    {
      "description": "Label Docker image version updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "labels": ["dependencies", "docker"]
    },
    {
      "description": "Major Python updates: separate PRs, no auto-merge",
      "matchManagers": ["pep621", "pip_requirements", "poetry", "pip-compile", "setup-cfg"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"]
    }
  ]
}
