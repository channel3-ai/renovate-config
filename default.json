{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/New_York)",
    "docker:pinDigests",
    "group:monorepos",
    "group:recommended",
    "schedule:daily"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "rangeStrategy": "bump",
  "postUpdateOptions": ["pnpmDedupe", "npmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "P1"],
    "schedule": ["at any time"],
    "assignees": ["glaw1300"],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "rangeStrategy": "update-lockfile",
    "vulnerabilityFixStrategy": "lowest"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group all non-major Python updates into one PR per week",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python non-major"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Refresh Docker image digests as soon as upstream images change",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "docker image digest updates",
      "labels": ["dependencies", "docker"],
      "schedule": ["at any time"]
    },
    {
      "description": "Label Docker image version updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "labels": ["dependencies", "docker"]
    },
    {
      "description": "Major Python updates: separate PRs, no auto-merge",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Package-manager majors (pnpm/npm/yarn) require explicit approval via the Dependency Dashboard",
      "matchDepTypes": ["packageManager"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
